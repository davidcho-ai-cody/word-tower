    zoomTo: 1.04
  - sprite: {fileID: 21300000, guid: 5ef60cfc19365c3448db5b43231efa31, type: 3}
    speaker: "\uC2AC\uB77C\uC784\uD0B9"
    dialogue: "\uC774... \uB530\uB73B\uD55C \uB290\uB08C\uC740...\n\n\uC65C \uC78A\uACE0
