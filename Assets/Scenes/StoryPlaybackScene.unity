    zoomTo: 1.04
  - sprite: {fileID: 21300000, guid: 9855001738789274a81a3c580b418579, type: 3}
    speaker: "\uC6A9\uC0AC"
    dialogue: "\uC774 \uAE00\uC790\uB294...\n\n\uC0AC\uB791"
    startTime: 6.2
    endTime: 9.4
